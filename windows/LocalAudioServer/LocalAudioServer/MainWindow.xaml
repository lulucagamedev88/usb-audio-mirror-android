<Window x:Class="LocalAudioServer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="USB Audio Mirror Server (Fase 1 + Fase 3.1 Bluetooth HFP)" 
        Height="680" Width="680"
        WindowStartupLocation="CenterScreen"
        Background="#0F172A"
        Foreground="#F8FAFC"
        FontFamily="Segoe UI, -apple-system, sans-serif"
        ResizeMode="CanMinimize">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- 1. Header -->
            <StackPanel Grid.Row="0" Margin="0,0,0,20">
                <TextBlock Text="USB Audio Mirror Server" FontSize="20" FontWeight="Bold" Foreground="#FFFFFF" />
                <TextBlock Text="Áudio PCM 48kHz via USB (Fase 1) &amp; Controlo de Chamadas Bluetooth HFP (Fase 3.1)" 
                           FontSize="12" Foreground="#94A3B8" Margin="0,3,0,0" />
            </StackPanel>

            <!-- 2. USB Status Card -->
            <Border Grid.Row="1" Background="#1E293B" CornerRadius="8" Padding="16" Margin="0,0,0,16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="ESTADO DA CONEXÃO USB (127.0.0.1:5000)" FontSize="11" FontWeight="SemiBold" Foreground="#94A3B8" />
                        <TextBlock x:Name="TxtStatus" Text="Servidor parado" FontSize="15" FontWeight="Bold" Foreground="#FFFFFF" Margin="0,4,0,0" />
                        <TextBlock x:Name="TxtSubStatus" Text="Clique em 'Iniciar Servidor' para aguardar o Android via USB." 
                                   FontSize="12" Foreground="#64748B" Margin="0,2,0,0" />
                    </StackPanel>

                    <Border Grid.Column="1" x:Name="BadgeState" Background="#334155" CornerRadius="4" Padding="10,4" VerticalAlignment="Center">
                        <TextBlock x:Name="TxtBadge" Text="INATIVO" FontSize="11" FontWeight="Bold" Foreground="#94A3B8" />
                    </Border>
                </Grid>
            </Border>

            <!-- 3. Stereo VU Meter -->
            <Border Grid.Row="2" Background="#1E293B" CornerRadius="8" Padding="16" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="NÍVEL DE ÁUDIO EM TEMPO REAL (VU METER)" FontSize="11" FontWeight="SemiBold" Foreground="#94A3B8" Margin="0,0,0,8" />
                    
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="20" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="L" FontSize="11" FontWeight="Bold" Foreground="#94A3B8" VerticalAlignment="Center" />
                        <ProgressBar Grid.Column="1" x:Name="VuMeterLeft" Height="10" Minimum="0" Maximum="1" Value="0" 
                                     Foreground="#10B981" Background="#0F172A" BorderThickness="0" />
                    </Grid>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="20" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="R" FontSize="11" FontWeight="Bold" Foreground="#94A3B8" VerticalAlignment="Center" />
                        <ProgressBar Grid.Column="1" x:Name="VuMeterRight" Height="10" Minimum="0" Maximum="1" Value="0" 
                                     Foreground="#10B981" Background="#0F172A" BorderThickness="0" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- 4. Telemetry Stats Grid -->
            <UniformGrid Grid.Row="3" Columns="3" Margin="0,0,0,16">
                <Border Background="#1E293B" CornerRadius="6" Padding="12" Margin="0,0,8,0">
                    <StackPanel>
                        <TextBlock Text="BITRATE REAL" FontSize="10" FontWeight="Bold" Foreground="#94A3B8" />
                        <TextBlock x:Name="TxtBitrate" Text="0 kbps" FontSize="16" FontWeight="Bold" Foreground="#38BDF8" Margin="0,4,0,0" />
                        <TextBlock Text="Alvo: 1536 kbps" FontSize="10" Foreground="#64748B" Margin="0,2,0,0" />
                    </StackPanel>
                </Border>

                <Border Background="#1E293B" CornerRadius="6" Padding="12" Margin="4,0,4,0">
                    <StackPanel>
                        <TextBlock Text="LATÊNCIA DO BUFFER" FontSize="10" FontWeight="Bold" Foreground="#94A3B8" />
                        <TextBlock x:Name="TxtLatency" Text="0 ms" FontSize="16" FontWeight="Bold" Foreground="#A78BFA" Margin="0,4,0,0" />
                        <TextBlock Text="Alvo: 80–180 ms" FontSize="10" Foreground="#64748B" Margin="0,2,0,0" />
                    </StackPanel>
                </Border>

                <Border Background="#1E293B" CornerRadius="6" Padding="12" Margin="8,0,0,0">
                    <StackPanel>
                        <TextBlock Text="DADOS RECEBIDOS" FontSize="10" FontWeight="Bold" Foreground="#94A3B8" />
                        <TextBlock x:Name="TxtTotalReceived" Text="0 MB" FontSize="16" FontWeight="Bold" Foreground="#34D399" Margin="0,4,0,0" />
                        <TextBlock x:Name="TxtTotalPackets" Text="0 pacotes" FontSize="10" Foreground="#64748B" Margin="0,2,0,0" />
                    </StackPanel>
                </Border>
            </UniformGrid>

            <!-- 5. USB Server Action Button -->
            <Button Grid.Row="4" x:Name="BtnToggleServer" Click="BtnToggleServer_Click"
                    Height="42" Background="#4F46E5" Foreground="#FFFFFF"
                    FontWeight="Bold" FontSize="13" Cursor="Hand" BorderThickness="0" Margin="0,0,0,24">
                <TextBlock Text="Iniciar Servidor USB" />
            </Button>

            <!-- 6. Divider -->
            <Separator Grid.Row="5" Background="#334155" Margin="0,0,0,24" />

            <!-- 7. Bluetooth Calls Section (Fase 3.1) -->
            <Border Grid.Row="6" Background="#1E293B" CornerRadius="8" Padding="18">
                <StackPanel>
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="CHAMADAS BLUETOOTH HFP (FASE 3.1)" FontSize="12" FontWeight="Bold" Foreground="#38BDF8" />
                            <TextBlock x:Name="TxtBtStatus" Text="Bluetooth desligado" FontSize="14" FontWeight="Bold" Foreground="#FFFFFF" Margin="0,4,0,0" />
                            <TextBlock x:Name="TxtBtSubStatus" Text="Conecte ao telemóvel para atender e desligar chamadas pelo PC." 
                                       FontSize="11" Foreground="#94A3B8" Margin="0,2,0,0" />
                        </StackPanel>

                        <Border Grid.Column="1" x:Name="BadgeBtState" Background="#334155" CornerRadius="4" Padding="10,4" VerticalAlignment="Center">
                            <TextBlock x:Name="TxtBtBadge" Text="DESCONECTADO" FontSize="10" FontWeight="Bold" Foreground="#94A3B8" />
                        </Border>
                    </Grid>

                    <Border Background="#0F172A" CornerRadius="6" Padding="14" Margin="0,4,0,14" BorderBrush="#334155" BorderThickness="1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock Text="ESTADO DA CHAMADA" FontSize="10" FontWeight="SemiBold" Foreground="#64748B" />
                                <TextBlock x:Name="TxtCallState" Text="Nenhuma chamada em curso" FontSize="14" FontWeight="Bold" Foreground="#E2E8F0" Margin="0,2,0,0" />
                                <TextBlock x:Name="TxtCallerId" Text="Linha livre" FontSize="12" Foreground="#94A3B8" Margin="0,1,0,0" />
                            </StackPanel>

                            <Border Grid.Column="1" x:Name="BadgeCallStatus" Background="#1E293B" CornerRadius="4" Padding="8,4" VerticalAlignment="Center">
                                <TextBlock x:Name="TxtCallBadge" Text="INATIVO" FontSize="10" FontWeight="Bold" Foreground="#64748B" />
                            </Border>
                        </Grid>
                    </Border>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*" />
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition Width="2*" />
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition Width="2*" />
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition Width="1.5*" />
                        </Grid.ColumnDefinitions>

                        <Button Grid.Column="0" x:Name="BtnToggleBluetooth" Click="BtnToggleBluetooth_Click"
                                Height="40" Background="#0284C7" Foreground="#FFFFFF"
                                FontWeight="SemiBold" FontSize="12" Cursor="Hand" BorderThickness="0">
                            <TextBlock Text="Ligar Bluetooth HFP" />
                        </Button>

                        <Button Grid.Column="2" x:Name="BtnAnswerCall" Click="BtnAnswerCall_Click"
                                Height="40" Background="#10B981" Foreground="#FFFFFF"
                                FontWeight="Bold" FontSize="12" Cursor="Hand" BorderThickness="0" IsEnabled="False">
                            <TextBlock Text="Atender" />
                        </Button>

                        <Button Grid.Column="4" x:Name="BtnHangUpCall" Click="BtnHangUpCall_Click"
                                Height="40" Background="#EF4444" Foreground="#FFFFFF"
                                FontWeight="Bold" FontSize="12" Cursor="Hand" BorderThickness="0" IsEnabled="False">
                            <TextBlock Text="Desligar" />
                        </Button>

                        <Button Grid.Column="6" x:Name="BtnSimulateCall" Click="BtnSimulateCall_Click"
                                Height="40" Background="#334155" Foreground="#CBD5E1"
                                FontWeight="Normal" FontSize="11" Cursor="Hand" BorderThickness="0"
                                ToolTip="Simular toque de chamada para teste">
                            <TextBlock Text="Simular" />
                        </Button>
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>
    </ScrollViewer>
</Window>